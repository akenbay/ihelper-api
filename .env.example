# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=api.ihelper.kz,localhost,127.0.0.1

# --- База данных (Dokploy provisioning: внешний Postgres) ---
DATABASE_URL=postgres://ihelper:password@postgres:5432/ihelper

# --- CORS: домен React-фронтенда (Vite) ---
CORS_ALLOWED_ORIGINS=https://ihelper.kz,http://localhost:5173

# --- Ссылки в письмах (приглашение родителя, сброс пароля) ---
FRONTEND_URL=https://ihelper.kz

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Приглашения (координатор/тьютор/родитель) ---
PARENT_INVITE_TTL_HOURS=72
STAFF_INVITE_TTL_HOURS=168

# --- Почта (Brevo transactional API) ---
# Три письма: приглашение, сброс пароля, уведомление о новом отчёте.
# BREVO_API_KEY задан  → письма уходят через Brevo (https://api.brevo.com/v3/smtp/email).
# BREVO_API_KEY пустой → откат на Django EMAIL_BACKEND (console: письмо печатается в лог).
# FRONTEND_URL (см. выше) формирует ссылки в письмах.
BREVO_API_KEY=
# DEFAULT_FROM_EMAIL должен быть verified sender в Brevo. Формат: адрес или «Имя <адрес>».
DEFAULT_FROM_EMAIL=noreply@ihelper.kz
# Локальный откат, если Brevo-ключа нет:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
